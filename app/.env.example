# --- Bao mat (BAT BUOC doi khi production) ---
PAYLOAD_SECRET=thay_secret_ngau_nhien_openssl_rand_hex_32
MCP_TOKEN=thay_token_mcp_manh

# --- Database ---
# Dev local (SQLite, khong can cai gi them):
DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./vtngason.db

# Production (docker-compose tu dung cac bien Postgres duoi day):
# DATABASE_ADAPTER=postgres
# DATABASE_URI=postgres://vtngason:matkhau@db:5432/vtngason
POSTGRES_DB=vtngason
POSTGRES_USER=vtngason
POSTGRES_PASSWORD=thay_mat_khau_postgres_manh

# --- Khac ---
NEXT_PUBLIC_SITE_URL=https://vienthongngason.com
MEDIA_DIR=media
SEED_ADMIN_EMAIL=admin@vienthongngason.com
# BAT BUOC tu dat, khong co gia tri mac dinh. Tao bang:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
SEED_ADMIN_PASSWORD=

# --- Email (BAT BUOC neu muon gui mail that: reset password, thong bao dang ky) ---
# Neu de trong, Payload chi in email ra console log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@vienthongngason.com
EMAIL_FROM_NAME=Vien Thong Nga Son

# --- Cloudflare Tunnel (production) ---
TUNNEL_TOKEN=
